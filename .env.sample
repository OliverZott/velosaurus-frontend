# Copy to .env.local (Next.js does not load .env.sample), keep ONE block active, restart "npm run dev".

# Nodejs docker
# NEXT_PUBLIC_ACCTIVITY_API_URL=http://localhost:3000/api/activity
# NEXT_PUBLIC_LOCATION_API_URL=http://localhost:3000/api/location

# ASP.NET Core local
# NEXT_PUBLIC_ACCTIVITY_API_URL=https://localhost:7019/api/v1/activity
# NEXT_PUBLIC_LOCATION_API_URL=https://localhost:7019/api/v1/location

# ASP.NET Core docker
NEXT_PUBLIC_ACCTIVITY_API_URL=http://localhost:8000/api/v1/activity
NEXT_PUBLIC_LOCATION_API_URL=http://localhost:8000/api/v1/location
