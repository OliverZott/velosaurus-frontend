# Copy to .env.local (Next.js does not load .env.sample), keep ONE block active, restart "npm run dev".

# Nodejs docker
# ACTIVITY_API_URL=http://localhost:3000/api/activity
# LOCATION_API_URL=http://localhost:3000/api/location

# ASP.NET Core local
# ACTIVITY_API_URL=https://localhost:7019/api/v1/activity
# LOCATION_API_URL=https://localhost:7019/api/v1/location

# ASP.NET Core docker
ACTIVITY_API_URL=http://localhost:8000/api/v1/activity
LOCATION_API_URL=http://localhost:8000/api/v1/location

# Optional: your LAN IP, only needed when opening the dev server via network address (e.g. from phone)
# DEV_ORIGINS=192.168.100.146
